{
  "version": 2,
  "builds": [
    {
      "src": "api/*.py",
      "use": "@vercel/python"
    },
    {
      "src": "mobile_app/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/ask",
      "dest": "/api/ask.py"
    },
    {
      "src": "/api/health",
      "dest": "/api/health.py"
    },
    {
      "src": "/api/trace",
      "dest": "/api/trace.py"
    },
    {
      "src": "/static/(.*)",
      "dest": "/mobile_app/$1"
    },
    {
      "src": "/(.*\\.(css|js|png|jpg|ico|svg|woff|woff2|ttf))",
      "dest": "/mobile_app/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/mobile_app/index.html"
    }
  ]
}
